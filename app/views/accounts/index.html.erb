<div class="px-4 py-4 lg:max-w-4xl lg:mx-auto lg:px-6 lg:py-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-xl font-bold text-slate-900">帳戶</h1>
    <div class="flex items-center gap-2">
      <%= link_to transaction_lists_path,
            class: "inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-slate-900 border border-slate-200 rounded-lg px-3 py-2 transition-colors" do %>
        <%= icon "list-bullet", classes: "w-4 h-4" %>
        所有交易
      <% end %>
      <%= link_to new_account_path,
            class: "inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors" do %>
        <%= icon "plus", classes: "w-4 h-4" %>
        新增帳戶
      <% end %>
    </div>
  </div>

  <% all_accounts = @budget_accounts + @asset_accounts + @liability_accounts %>
  <% total_all = all_accounts.sum { |a| a.tracking? ? a.current_balance.abs : a.balance.abs } %>

  <% sections = [
       ["預算帳戶", @budget_accounts, false],
       ["資產帳戶", @asset_accounts, true],
       ["負債帳戶", @liability_accounts, true]
     ] %>

  <% sections.each do |label, accounts, is_tracking| %>
    <% next if accounts.empty? %>
    <div class="mb-6">
      <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3"><%= label %></h2>
      <div class="space-y-2">
        <% accounts.each do |account| %>
          <% display_balance = is_tracking ? account.current_balance : account.balance %>
          <% pct = total_all > 0 ? (display_balance.abs / total_all * 100).round : 0 %>
          <div class="bg-white rounded-xl border border-slate-100 px-5 py-4 hover:border-indigo-200 hover:shadow-sm transition-all">
            <div class="flex items-center justify-between mb-2">
              <div>
                <%= link_to account.name, account_path(account), class: "text-sm font-medium text-slate-800 hover:text-indigo-600" %>
                <% if is_tracking && !account.investable? %>
                  <span class="text-xs bg-amber-100 text-amber-700 px-1.5 py-0.5 rounded ml-2">非流動</span>
                <% end %>
                <% if is_tracking %>
                  <% latest_snapshot = account.balance_snapshots.max_by(&:date) %>
                  <% if latest_snapshot %>
                    <span class="text-xs text-slate-400 ml-1">
                      (<%= latest_snapshot.date.strftime("%Y-%m-%d") %>)
                    </span>
                  <% end %>
                <% end %>
              </div>
              <div class="flex items-center gap-3">
                <% if is_tracking %>
                  <%= link_to "更新餘額", new_account_balance_snapshot_path(account),
                        class: "text-xs text-indigo-600 hover:text-indigo-800 font-medium" %>
                <% end %>
                <span class="text-base font-bold text-slate-900">
                  <%= format_amount(display_balance) %>
                </span>
              </div>
            </div>
            <div class="w-full bg-slate-100 rounded-full h-1.5">
              <div class="bg-indigo-500 h-1.5 rounded-full" style="width: <%= pct %>%"></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
