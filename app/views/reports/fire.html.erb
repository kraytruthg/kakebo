<div class="px-4 py-4 lg:max-w-4xl lg:mx-auto lg:px-6 lg:py-8">
  <%= render "reports/tabs" %>

  <%# FIRE Goal Settings %>
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 mb-6">
    <h2 class="text-sm font-semibold text-slate-700 mb-4">FIRE 目標設定</h2>
    <% form_url = @fire_goal.persisted? ? fire_goal_path : fire_goal_path %>
    <% form_method = @fire_goal.persisted? ? :patch : :post %>
    <%= form_with model: @fire_goal, url: form_url, method: form_method, class: "space-y-4" do |f| %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :withdrawal_rate, "提領率 (%)", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.number_field :withdrawal_rate, step: 0.1, min: 0.1,
                class: "block w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" %>
        </div>
        <div>
          <%= f.label :expected_return_rate, "預期投報率 (%)", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.number_field :expected_return_rate, step: 0.1, min: 0.1,
                class: "block w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" %>
        </div>
        <div>
          <%= f.label :target_annual_expense, "年支出（留空自動計算）", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.number_field :target_annual_expense, step: 1,
                placeholder: @fire_goal.persisted? ? format_amount(@fire_goal.household.actual_annual_expense) : "自動",
                class: "block w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" %>
        </div>
        <div>
          <%= f.label :target_amount, "FIRE Number（留空自動計算）", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.number_field :target_amount, step: 1,
                placeholder: @fire_goal.persisted? ? format_amount(@fire_goal.fire_number) : "自動",
                class: "block w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" %>
        </div>
      </div>
      <div>
        <%= f.submit @fire_goal.persisted? ? "更新目標" : "設定目標",
              class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 px-6 rounded-lg cursor-pointer transition-colors text-sm" %>
      </div>
    <% end %>
  </div>

  <% if @fire_goal.persisted? %>
    <%# Asset Breakdown %>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
        <p class="text-xs font-semibold text-indigo-500 uppercase tracking-wider mb-1">可投資淨資產</p>
        <p class="text-2xl font-bold text-slate-900"><%= format_amount(@household.investable_net_worth) %></p>
        <p class="text-xs text-slate-400 mt-1">計入 FIRE 目標計算</p>
      </div>
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
        <p class="text-xs font-semibold text-amber-500 uppercase tracking-wider mb-1">非流動資產（安全墊）</p>
        <p class="text-2xl font-bold text-slate-900"><%= format_amount(@household.non_investable_net_worth) %></p>
        <p class="text-xs text-slate-400 mt-1">自住房淨值等，不計入 FIRE</p>
      </div>
    </div>

    <%# Progress Section %>
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 mb-6">
      <h2 class="text-sm font-semibold text-slate-700 mb-4">FIRE 進度</h2>

      <% progress = @fire_goal.progress_percentage %>
      <% capped_progress = [progress, 100].min %>

      <div class="mb-4">
        <div class="w-full bg-slate-100 rounded-full h-4 mb-2">
          <div class="bg-indigo-500 h-4 rounded-full transition-all" style="width: <%= capped_progress %>%"></div>
        </div>
        <p class="text-2xl font-bold text-slate-900"><%= progress %>%</p>
      </div>

      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between text-sm text-slate-600 mb-4">
        <span>可投資淨資產 <strong><%= format_amount(@household.investable_net_worth) %></strong></span>
        <span>FIRE 目標 <strong><%= format_amount(@fire_goal.fire_number) %></strong></span>
      </div>

      <% projected = @fire_goal.projected_fire_date %>
      <% if projected %>
        <% if projected <= Date.current %>
          <p class="text-lg font-semibold text-green-600">已達成 FIRE 目標！</p>
        <% else %>
          <% diff_months = (projected.year * 12 + projected.month) - (Date.current.year * 12 + Date.current.month) %>
          <% years = diff_months / 12 %>
          <% months = diff_months % 12 %>
          <p class="text-sm text-slate-600">
            預計達成：<strong><%= projected.strftime("%Y-%m") %></strong>
            （約 <%= years %> 年 <%= months %> 個月）
          </p>
        <% end %>
      <% else %>
        <p class="text-sm text-slate-400">以目前條件，100 年內無法達成</p>
      <% end %>
    </div>

    <%# Net Worth vs FIRE Number Chart %>
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
      <h2 class="text-sm font-semibold text-slate-700 mb-4">淨資產 vs FIRE Number</h2>
      <% if @net_worth_series.any? %>
        <%
          fire_target_line = @net_worth_series.transform_values { @fire_goal.fire_number }
        %>
        <%= line_chart [
              { name: "總淨資產", data: @net_worth_series },
              { name: "FIRE 目標", data: fire_target_line }
            ], prefix: "$", thousands: ",", height: "300px" %>
      <% else %>
        <p class="text-sm text-slate-400 text-center py-8">尚無資料</p>
      <% end %>
    </div>
  <% end %>
</div>
