<div class="px-4 py-4 lg:max-w-4xl lg:mx-auto lg:px-6 lg:py-8">
  <%= render "reports/tabs" %>

  <%# Summary cards %>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
      <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">淨資產</p>
      <p class="text-2xl font-bold text-slate-900"><%= format_amount(@net_worth) %></p>
    </div>
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
      <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">儲蓄率（本月）</p>
      <p class="text-2xl font-bold text-slate-900"><%= @savings_rate_month %>%</p>
    </div>
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
      <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">儲蓄率（年）</p>
      <p class="text-2xl font-bold text-slate-900"><%= @savings_rate_year %>%</p>
    </div>
  </div>

  <%# Net worth trend chart %>
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 mb-6">
    <h2 class="text-sm font-semibold text-slate-700 mb-4">淨資產走勢</h2>
    <% if @net_worth_series.any? %>
      <%= line_chart @net_worth_series, prefix: "$", thousands: ",", height: "300px" %>
    <% else %>
      <p class="text-sm text-slate-400 text-center py-8">尚無資料</p>
    <% end %>
  </div>

  <%# Income vs Expense chart %>
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
    <h2 class="text-sm font-semibold text-slate-700 mb-4">收支趨勢</h2>
    <% if @income_expense_series[:income].any? %>
      <%= column_chart [
            { name: "收入", data: @income_expense_series[:income] },
            { name: "支出", data: @income_expense_series[:expense] }
          ], prefix: "$", thousands: ",", height: "300px" %>
    <% else %>
      <p class="text-sm text-slate-400 text-center py-8">尚無資料</p>
    <% end %>
  </div>
</div>
