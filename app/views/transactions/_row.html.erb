<tr class="border-t border-slate-50 hover:bg-slate-50 group transition-colors" id="transaction-<%= transaction.id %>">
  <td class="pl-5 py-3 w-8">
    <% if transaction.reconciled? %>
      <%= icon "lock-closed", classes: "w-4 h-4 text-slate-300" %>
    <% elsif transaction.cleared? %>
      <span class="inline-block w-4 h-4 rounded-full border-2 border-indigo-400 bg-indigo-100"></span>
    <% else %>
      <span class="inline-block w-4 h-4 rounded-full border-2 border-slate-200"></span>
    <% end %>
  </td>
  <td class="px-5 py-3 text-sm text-slate-500"><%= transaction.date.strftime("%m/%d") %></td>
  <td class="px-5 py-3 text-sm text-slate-800"><%= transaction.memo.presence || "─" %></td>
  <td class="px-5 py-3 text-sm text-slate-400">
    <%= transaction_category_label(transaction) %>
  </td>
  <td class="px-5 py-3 text-right text-sm font-medium <%= transaction.amount < 0 ? 'text-red-500' : 'text-emerald-600' %>">
    <%= format_amount(transaction.amount) %>
  </td>
  <td class="px-5 py-3 text-right flex items-center gap-2 justify-end">
    <% if transaction.reconciled? %>
      <span class="text-xs text-slate-300">已鎖定</span>
    <% else %>
      <% unless transaction.transfer? %>
        <%= link_to "編輯", edit_account_transaction_path(account, transaction),
            class: "text-sm text-blue-500 hover:text-blue-700" %>
      <% end %>
      <% if transaction.transfer? %>
        <%= button_to transfer_path(transaction),
              method: :delete,
              data: { turbo_confirm: "確定刪除這筆轉帳？兩個帳戶的對應紀錄都會一併刪除。" },
              class: "opacity-0 group-hover:opacity-100 transition-opacity text-slate-300 hover:text-red-500",
              aria: { label: "刪除交易" } do %>
          <%= icon "trash", classes: "w-4 h-4" %>
        <% end %>
      <% else %>
        <%= button_to account_transaction_path(account, transaction),
              method: :delete,
              data: { turbo_confirm: "確定刪除這筆交易？" },
              class: "opacity-0 group-hover:opacity-100 transition-opacity text-slate-300 hover:text-red-500",
              aria: { label: "刪除交易" } do %>
          <%= icon "trash", classes: "w-4 h-4" %>
        <% end %>
      <% end %>
    <% end %>
  </td>
</tr>
